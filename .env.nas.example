# Copy to .env on your NAS. Enter secrets only in that private file.
# Keep single quotes around values so $ in a password stays literal.
APP_PASSWORD=''
VW_USERNAME=''
VW_PASSWORD=''
VW_VIN=''
# Local HTTP on home Wi-Fi. For an HTTPS reverse proxy use COOKIE_SECURE=1.
COOKIE_SECURE=0
# Use 127.0.0.1 instead when accessing only through a reverse proxy on the NAS.
PASSAT_BIND_IP=0.0.0.0
